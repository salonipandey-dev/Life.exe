# Copy to .env (never commit .env). All settings are optional in development.
LIFEEXE_ENV=development            # development | production
LIFEEXE_HOST=127.0.0.1
LIFEEXE_PORT=8000
LIFEEXE_DB_PATH=./data/lifeexe.db  # SQLite file; put it on a persistent volume in production
LIFEEXE_SESSION_TTL_HOURS=336      # 14 days
LIFEEXE_SECURE_COOKIES=            # defaults to true when LIFEEXE_ENV=production (HTTPS required)
LIFEEXE_AUTH_RATE_LIMIT=10         # auth attempts per minute per client IP
LIFEEXE_ALLOWED_ORIGINS=           # extra origins allowed for state-changing requests (comma-separated)
LIFEEXE_FRONTEND_DIST=./frontend/dist
LIFEEXE_LOG_LEVEL=INFO
